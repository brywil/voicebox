[Unit]
Description=mymcp (voicebox) — a deliberately tiny tool catalog
Documentation=file:///home/bryan/src/voicebox/docs/MYMCP.md
After=network-online.target goclaw-chromium.service
Wants=network-online.target goclaw-chromium.service

[Service]
Type=simple
EnvironmentFile=%h/.config/mymcp/mymcp.env
Environment=MYMCP_ALLOW_REMOTE=false
ExecStart=/home/bryan/.local/bin/mymcp serve \
  --addr 127.0.0.1:9445 \
  --workspace %h \
  --memory-dir %h/.local/share/voicebox/memory \
  --cache-dir %h/.local/share/voicebox/scratch \
  --allow-exec=false \
  --tools list_tools,web_search_free,web_search_paid,web_fetch,parse_json,memory_save,memory_search,memory_read,memory_list,read_file,list_directory,find_files,grep,date_now
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
