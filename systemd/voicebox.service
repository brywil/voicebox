[Unit]
Description=voicebox — browser voice interface for local and cloud LLMs
Documentation=file:///home/bryan/src/voicebox/README.md
After=network-online.target voicebox-tts.service
Wants=network-online.target voicebox-tts.service

[Service]
Type=simple
WorkingDirectory=/home/bryan/src/voicebox
EnvironmentFile=-/home/bryan/.config/voicebox/voicebox.env
ExecStart=/home/bryan/src/voicebox/voicebox
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
